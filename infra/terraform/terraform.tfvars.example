# Example terraform.tfvars file
# Copy this to terraform.tfvars and customize for your deployment

# Environment configuration
environment_name = "dev"
name            = "rtaudioagent"
location        = "uksouth"

# Principal configuration (replace with your user ID)
# Get your principal ID with: az ad signed-in-user show --query id -o tsv
principal_id   = "your-user-principal-id-here"
principal_type = "User"

# Azure Communication Services data location
acs_data_location = "UK"

# Voice Live is not available in UK regions today; Sweden is the preferred European fallback.
voice_live_location = "swedencentral"

# Authentication settings
disable_local_auth = true

# Application Gateway stays disabled until all required origin TLS inputs are set.
# app_gateway_origin_certificate_secret_id       = "https://<vault>.vault.azure.net/secrets/<name>/<version>"
# app_gateway_trusted_root_certificate_base64    = "<base64-encoded-public-ca-certificate>"

# Redis Enterprise SKU (adjust based on your needs and regional availability)
redis_sku = "MemoryOptimized_M10"

# OpenAI model deployments
model_deployments = [
    {
      name     = "gpt-4o"
      version  = "2024-11-20"
      sku_name = "DataZoneStandard"
      capacity = 50
    },
    {
      name     = "gpt-4o-mini"
      version  = "2024-07-18"
      sku_name = "DataZoneStandard"
      capacity = 50
    },
    {
      name     = "gpt-4.1-mini"
      version  = "2025-04-14"
      sku_name = "DataZoneStandard"
      capacity = 50
    },
    {
      name     = "gpt-4.1"
      version  = "2025-04-14"
      sku_name = "DataZoneStandard"
      capacity = 50
    }
  ]
